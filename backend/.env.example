# このファイルを .env にコピーして使う（.env は Git に含めない）
#   cp .env.example .env

# ---- AI ----
# Claude API キー。設定すると AI解説が Claude（claude-opus-5-5）で作られる。
# 未設定ならルールベースの解説で動く（デモは止まらない）。
ANTHROPIC_API_KEY=
# auto: キーがあれば Claude / claude: 常に Claude（ant auth login の認証も使える）/ rules: 常にルールベース
AI_PROVIDER=auto
CLAUDE_MODEL=claude-opus-5-5
# 待ち時間と品質のバランス（low | medium | high）
CLAUDE_EFFORT=low
CLAUDE_TIMEOUT=45
# 1人あたり 10分間に Claude を呼べる回数（超えるとルールベース）
AI_RATE_MAX=20

# ---- 保存 ----
# MITSUKARU_DB=var/mitsukaru.db
MITSUKARU_RETENTION_DAYS=90
# HTTPS で公開するときは 1
MITSUKARU_COOKIE_SECURE=0
